# Copy to ".env" (or set these in your Render / Railway dashboard).
# The app works WITHOUT a key (local-dataset mode: rich data, placeholder posters).
# Add a free TMDB key to unlock posters, backdrops, trailers and streaming providers.

# Get one at: https://www.themoviedb.org/settings/api  (v3 "API Key")
TMDB_API_KEY=

# Region used for "where to stream" lookups (ISO 3166-1 country code).
TMDB_REGION=US
